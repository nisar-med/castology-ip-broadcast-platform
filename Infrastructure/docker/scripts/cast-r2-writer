#!/usr/bin/env python3
"""
MistServer external writer — uploads segment from stdin to Cloudflare R2.
Called by MistServer as: cast-r2-writer <url>

URL format: r2://ACCESS_KEY:SECRET_KEY@ACCOUNT_ID.r2.cloudflarestorage.com/bucket/key
Or via env:  R2_ENDPOINT, R2_ACCESS_KEY, R2_SECRET_KEY
"""
import sys, os, boto3
from urllib.parse import urlparse, unquote

def main():
    if len(sys.argv) < 2:
        sys.exit(1)

    raw = sys.argv[1]
    parsed = urlparse(raw)

    # Credentials from URL or env
    access_key = unquote(parsed.username) if parsed.username else os.environ.get("R2_ACCESS_KEY","")
    secret_key = unquote(parsed.password) if parsed.password else os.environ.get("R2_SECRET_KEY","")
    endpoint   = os.environ.get("R2_ENDPOINT", f"https://{parsed.hostname}")

    # bucket/key from path
    path_parts = parsed.path.lstrip("/").split("/", 1)
    bucket = path_parts[0]
    key    = path_parts[1] if len(path_parts) > 1 else parsed.path.lstrip("/")

    data = sys.stdin.buffer.read()
    if not data:
        print(f"[cast-r2-writer] empty stdin for {key}", file=sys.stderr)
        sys.exit(1)

    content_type = "application/vnd.apple.mpegurl" if key.endswith(".m3u8") else "video/mp2t"

    s3 = boto3.client(
        "s3",
        endpoint_url=endpoint,
        aws_access_key_id=access_key,
        aws_secret_access_key=secret_key,
        region_name="auto",
    )
    s3.put_object(Bucket=bucket, Key=key, Body=data, ContentType=content_type)
    print(raw, flush=True)

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"[cast-r2-writer] {e}", file=sys.stderr)
        sys.exit(1)
