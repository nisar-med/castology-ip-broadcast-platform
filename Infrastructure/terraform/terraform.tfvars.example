# Copy to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to version control.
#
# Apply everything:    terraform apply
# Apply one module:    terraform apply -target=module.dns

# ---------------------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------------------
cloudflare_api_token  = "REPLACE_WITH_CLOUDFLARE_API_TOKEN"
cloudflare_account_id = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"

# ---------------------------------------------------------------------------
# R2
# ---------------------------------------------------------------------------
r2_bucket_name = "castology-hls"

# ---------------------------------------------------------------------------
# VPS
# ---------------------------------------------------------------------------
# Public IP used for DNS/app traffic. Admin SSH can move to Tailscale via
# Infrastructure/docker/.env without changing Terraform.
vps_ip = "1.2.3.4"

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
srt_ingest_port  = 1235
srt_output_ports = [1234]
